/* ===== Trust / explanatory band ===== */
.trust
  padding 56px 0
  background var(--color-bg-alt)
  border-top 1px solid var(--color-border-light)

.trust-inner
  max-width 72ch
  h2
    font-size 1.4rem
    margin-bottom 12px
  p
    color var(--color-text-secondary)
    font-size 0.94rem
    margin-bottom 18px

.trust-inline
  margin-top 64px
