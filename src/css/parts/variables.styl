/* ===== CSS Variables (shared design tokens with electerm.org) ===== */
:root
  color-scheme light
  --color-text-inverse: #fff
  --color-header-bg: rgba(255, 255, 255, 0.94)
  --color-primary: #2563eb
  --color-primary-dark: #1d4ed8
  --color-primary-light: #eff6ff
  --color-bg: #ffffff
  --color-bg-alt: #f8fafc
  --color-text: #0f172a
  --color-text-secondary: #64748b
  --color-text-muted: #94a3b8
  --color-border: #e2e8f0
  --color-border-light: #f1f5f9
  --radius-sm: 6px
  --radius-md: 10px
  --radius-lg: 14px
  --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.04)
  --shadow-md: 0 6px 20px -8px rgba(15, 23, 42, 0.18)
  --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif
  --font-mono: 'SF Mono', 'Fira Code', 'Fira Mono', 'Roboto Mono', monospace
  --max-width: 1080px
  --header-height: 64px

:root[data-theme='dark']
  color-scheme dark
  --color-primary: #60a5fa
  --color-primary-dark: #93c5fd
  --color-primary-light: #1e3a5f
  --color-bg: #0f172a
  --color-bg-alt: #1e293b
  --color-text: #f1f5f9
  --color-text-secondary: #cbd5e1
  --color-text-inverse: #07111f
  --color-border: #334155
  --color-border-light: #253147
  --color-header-bg: rgba(15,23,42,0.92)
  --shadow-sm: 0 1px 2px rgba(0,0,0,0.3)
  --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.4), 0 2px 4px -2px rgba(0,0,0,0.3)
