/* ===== Layout + shared type utilities ===== */
.container
  width 100%
  max-width var(--max-width)
  margin 0 auto
  padding 0 24px

@media (min-width: 768px)
  .container
    padding 0 32px

.eyebrow
  font-size 0.72rem
  font-weight 600
  letter-spacing 0.12em
  text-transform uppercase
  color var(--color-primary)

.section-head
  display flex
  flex-direction column
  gap 6px
  margin-bottom 28px
  h2
    font-size 1.5rem
  p
    max-width 68ch
    color var(--color-text-secondary)
    font-size 0.94rem

.text-link
  font-size 0.9rem
  font-weight 550
  &::after
    content ' →'

.btn
  display inline-flex
  align-items center
  justify-content center
  padding 10px 20px
  border 1px solid var(--color-primary)
  border-radius var(--radius-sm)
  background var(--color-primary)
  color #fff
  font-size 0.9rem
  font-weight 550
  &:hover
    background var(--color-primary-dark)
    color #fff

code, .mono
  font-family var(--font-mono)
  font-size 0.86em
