/* ===== Widget detail page ===== */
.breadcrumb
  display flex
  align-items center
  gap 10px
  padding 28px 0 0
  font-size 0.82rem
  color var(--color-text-muted)
  .sep
    color var(--color-border)

.widget-hero
  padding 32px 0 48px
  border-bottom 1px solid var(--color-border-light)

.widget-title
  font-size clamp(2rem, 4vw, 2.6rem)
  margin 12px 0 16px

.widget-lead
  max-width 65ch
  font-size 1.05rem
  color var(--color-text-secondary)

.widget-tags
  display flex
  flex-wrap wrap
  gap 8px
  margin-top 24px

.tag
  font-family var(--font-mono)
  font-size 0.74rem
  padding 4px 10px
  border 1px solid var(--color-border)
  border-radius 999px
  color var(--color-text-secondary)

.detail-section, .install-section
  padding 48px 0 0

.detail-grid
  display grid
  grid-template-columns 1fr
  border 1px solid var(--color-border)
  border-radius var(--radius-md)
  overflow hidden

.detail-item
  padding 16px 20px
  border-bottom 1px solid var(--color-border-light)
  dt
    font-size 0.72rem
    text-transform uppercase
    letter-spacing 0.09em
    color var(--color-text-muted)
    margin-bottom 4px
  dd
    font-size 0.92rem
    word-break break-word
    &.mono
      font-size 0.8rem

@media (min-width: 640px)
  .detail-grid
    grid-template-columns repeat(2, 1fr)
  .detail-item:nth-child(odd)
    border-right 1px solid var(--color-border-light)

.digest-block
  margin-top 24px
  padding 20px
  background var(--color-bg-alt)
  border 1px solid var(--color-border)
  border-radius var(--radius-md)
  code
    display block
    margin-top 8px
    word-break break-all
    font-size 0.78rem
    color var(--color-text-secondary)

.install-section
  padding-bottom 8px
