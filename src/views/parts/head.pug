meta(charset='utf-8')
meta(name='viewport' content='width=device-width, initial-scale=1')
title= title
meta(name='description' content=description)
meta(name='theme-color' content='#ffffff')
link(rel='canonical' href=host + url)

//- Brand assets are served from electerm.org; only the site-specific manifest
//- is local, so no icon/logo binaries are duplicated here.
link(rel='preconnect' href=assetHost)
link(rel='icon' type='image/x-icon' href=assetHost + '/favicon.ico')
link(rel='icon' type='image/png' sizes='32x32' href=assetHost + '/favicon-32x32.png')
link(rel='icon' type='image/png' sizes='16x16' href=assetHost + '/favicon-16x16.png')
link(rel='apple-touch-icon' sizes='180x180' href=assetHost + '/apple-touch-icon.png')
link(rel='manifest' href='/site.webmanifest')

meta(property='og:type' content='website')
meta(property='og:site_name' content='electerm widgets')
meta(property='og:title' content=title)
meta(property='og:description' content=description)
meta(property='og:url' content=host + url)
meta(property='og:image' content=assetHost + '/android-chrome-512x512.png')
meta(property='og:image:width' content='512')
meta(property='og:image:height' content='512')
meta(property='og:image:alt' content='electerm logo')
meta(name='twitter:card' content='summary_large_image')

link(rel='stylesheet' href=cssUrl)
