header.site-header
  .container.header-inner
    a.header-logo(href='/')
      img(src='/electerm.png' alt='')
      span.header-logo-text electerm
      span.header-logo-sub widgets
    nav.header-nav
      a(href='/') Widgets
      a(href='https://electerm.org' target='_blank' rel='noreferrer') electerm
      a(href='https://github.com/electerm/electerm' target='_blank' rel='noreferrer') GitHub
    .header-actions
      a.header-cta(href='https://github.com/electerm/widgets.electerm.org' target='_blank' rel='noreferrer') Registry source
